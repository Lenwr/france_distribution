{
  "name": "france-distribution",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/validation.test.js",
    "test:integration": "node --test tests/inventory.test.js",
    "test:emulator": "firebase emulators:exec --project demo-france-distribution --only firestore \"npm run test:integration\"",
    "test:e2e": "playwright test",
    "setup:admin": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "emulators": "firebase emulators:start --project demo-france-distribution --only auth,firestore"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "@tailwindcss/vite": "^4.0.14",
    "firebase": "^12.16.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.471.1",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.5.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-barcode-scanner": "^2.0.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.1.5",
    "react-router-dom": "^7.1.1",
    "react-toastify": "^11.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "daisyui": "^5.7.32",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.30.0",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.14",
    "vite": "^6.0.5"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "uuid": "^11.1.1",
    "qs": "^6.15.3",
    "csv-parse": "^7.0.2"
  }
}
